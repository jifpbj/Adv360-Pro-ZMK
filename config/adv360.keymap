#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&lt { quick-tap-ms = <199>; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <220>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <270>;
        };

        parenthesis_less_than: parenthesis_less_than {
            compatible = "zmk,behavior-mod-morph";
            label = "PARENTHESIS_LESS_THAN";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        parenthsis_greater_than: parenthsis_greater_than {
            compatible = "zmk,behavior-mod-morph";
            label = "PARENTHSIS_GREATER_THAN";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        layer_tap_typing: layer_tap_typing {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TYPING";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <170>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };

        hm_left: hm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <270>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75 35 36 52 65 66 67>;
        };

        hw_right: hw_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HW_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <270>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <37 38 53 68 69 70 35 36 52 65 66 67 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66>;
        };

        hm_shift: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <50>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <270>;
        };
    };

    combos {
        compatible = "zmk,combos";

        LH-esc {
            bindings = <&kp ESCAPE>;
            key-positions = <30 31>;
        };

        rh-tab {
            bindings = <&kp TAB>;
            key-positions = <30 29>;
        };

        backspace-combo {
            bindings = <&kp BACKSPACE>;
            key-positions = <24 23>;
            require-prior-idle-ms = <130>;
        };

        forward-slash-rh {
            bindings = <&kp SLASH>;
            key-positions = <42 56>;
        };

        hr-r-bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <43 42>;
        };

        hr-l-bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <41 42>;
            require-prior-idle-ms = <130>;
        };

        l-parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <55 56>;
        };

        r-parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <56 57>;
        };

        mod-parenthesis-lessthan {
            bindings = <&parenthesis_less_than>;
            key-positions = <55 56>;
        };

        parenthesis-greater-than {
            bindings = <&parenthsis_greater_than>;
            key-positions = <56 57>;
        };

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <48 49>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <50 49>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <23 41>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <41 55>;
        };

        asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <42 24>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <32 50>;
        };

        at-sign {
            bindings = <&kp AT_SIGN>;
            key-positions = <16 30>;
        };

        backtick {
            bindings = <&kp GRAVE>;
            key-positions = <17 31>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <22 40>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <25 24>;
            require-prior-idle-ms = <130>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <19 33>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <18 32>;
        };

        hashtag {
            bindings = <&kp HASH>;
            key-positions = <30 48>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <25 43>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <43 57>;
        };

        enter {
            bindings = <&kp RETURN>;
            key-positions = <43 41>;
        };

        exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <26 44>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <43 44>;
        };

        enter-lh {
            bindings = <&kp RETURN>;
            key-positions = <32 31>;
        };

        spotlight {
            bindings = <&kp LG(SPACE)>;
            key-positions = <65 70>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <33 51>;
        };

        space-leader {
            bindings = <&kp SPACE>;
            key-positions = <32 30>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <31 49>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <40 54>;
        };

        cut {
            bindings = <&kp LG(X)>;
            key-positions = <48 50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1            &kp N2               &kp N3               &kp N4                  &kp N5  &tog 1                                                                       &mo 4        &kp N6  &kp N7                   &kp N8                 &kp N9                 &kp N0                     &kp MINUS
&kp TAB    &kp Q             &kp W                &kp E                &kp R                   &kp T   &none                                                                        &tog 6       &kp Y   &kp U                    &kp I                  &kp O                  &kp P                      &kp BSLH
&kp ESC    &hm_left LCTRL A  &hm_left LEFT_ALT S  &hm_left LEFT_GUI D  &hm_shift LEFT_SHIFT F  &kp G   &bootloader               &kp LEFT_GUI  &kp LALT       &kp LGUI   &kp RCTRL  &bootloader  &kp H   &hm_shift RIGHT_SHIFT J  &hw_right RIGHT_GUI K  &hw_right RIGHT_ALT L  &hw_right RCTRL SEMICOLON  &kp SQT
&kp LSHFT  &kp Z             &kp X                &kp C                &kp V                   &kp B                                           &kp HOME       &kp PG_UP                          &kp N   &kp M                    &kp COMMA              &kp DOT                &kp FSLH                   &kp RSHFT
&mo 3      &kp GRAVE         &kp CAPS             &none                &none                           &mt LEFT_SHIFT BACKSPACE  &lt 1 DEL     &lt 2 END      &kp PG_DN  &lt 2 RET  &kp SPACE            &kp UP                   &kp DOWN               &kp LBKT               &kp RBKT                   &mo 3
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2                &kp N3          &kp N4                &kp N5  &trans                                                   &mo 4      &kp N6           &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp C_BRIGHTNESS_DEC  &kp UP_ARROW    &kp C_BRIGHTNESS_INC  &kp T   &none                                                    &none      &kp Y            &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp LEFT_ARROW        &kp DOWN_ARROW  &kp RIGHT_ARROW       &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H            &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp C_MUTE            &kp C_VOL_DN    &kp C_VOLUME_UP       &kp B                        &kp HOME      &kp PG_UP                        &kp KP_NUMBER_0  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS              &kp LEFT        &kp RIGHT                     &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0                   &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 3
            >;
        };

        Symbols {
            bindings = <
&trans  &trans           &trans         &trans            &trans           &trans         &trans                                      &trans  &trans       &trans                &trans                 &trans         &trans             &trans
&trans  &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS        &kp PIPE       &trans                                      &trans  &kp CARET    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOLLAR     &trans             &trans
&trans  &kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL        &kp AMPERSAND  &trans  &trans  &trans      &trans  &trans  &trans  &kp HASH     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON  &kp SQT            &trans
&trans  &kp TILDE        &kp PLUS       &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp PERCENT                    &trans      &trans                  &kp AT_SIGN  &kp COMMA             &kp PERIOD             &kp COLON      &kp DOUBLE_QUOTES  &trans
&trans  &trans           &trans         &trans            &trans                          &trans  &trans  &trans      &trans  &trans  &trans               &trans                &trans                 &trans         &trans             &trans
            >;
        };

        fn-vim {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &kp H   &kp J   &kp K   &kp L    &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        qwerty_no_mods {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3  &kp N4  &kp N5  &tog 1                                                            &mo 4        &kp N6  &kp N7  &kp N8     &kp N9    &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E   &kp R   &kp T   &none                                                             &to 0        &kp Y   &kp U   &kp I      &kp O     &kp P          &kp BSLH
&kp ESC    &kp A      &kp S     &kp D   &kp F   &kp G   &bootloader    &kp LEFT_GUI  &kp LALT       &kp LGUI   &kp RCTRL  &bootloader  &kp H   &kp J   &kp K      &kp L     &kp SEMICOLON  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C   &kp V   &kp B                                &kp HOME       &kp PG_UP                          &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH       &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &none   &none           &kp BACKSPACE  &lt 1 DEL     &lt 2 END      &kp PG_DN  &lt 2 RET  &kp SPACE            &kp UP  &kp DOWN   &kp LBKT  &kp RBKT       &mo 3
            >;
        };

        colemak_dh {
            display-name = "Secondary";
            bindings = <
&kp EQUAL  &kp N1       &kp N2          &kp N3          &kp N4            &kp N5  &tog 1                                                                       &mo 4      &kp N6  &kp N7             &kp N8           &kp N9           &kp N0       &kp MINUS
&kp TAB    &kp Q        &kp W           &kp F           &kp P             &kp B   &none                                                                        &none      &kp J   &kp L              &kp U            &kp Y            &kp SEMI     &kp BSLH
&kp ESC    &hm LCTRL A  &hm LEFT_ALT R  &hm LEFT_GUI S  &hm LEFT_SHIFT T  &kp G   &none                     &kp LEFT_GUI  &kp LALT       &kp LGUI   &kp RCTRL  &none      &kp M   &hm RIGHT_SHIFT N  &hm RIGHT_GUI E  &hm RIGHT_ALT I  &hm RCTRL O  &kp SQT
&kp LSHFT  &kp Z        &kp X           &kp C           &kp D             &kp V                                           &kp HOME       &kp PG_UP                        &kp K   &kp H              &kp COMMA        &kp DOT          &kp FSLH     &kp RSHFT
&mo 3      &kp GRAVE    &kp CAPS        &none           &none                     &mt LEFT_SHIFT BACKSPACE  &lt 1 DEL     &lt 2 END      &kp PG_DN  &lt 2 RET  &kp SPACE          &kp UP             &kp DOWN         &kp LBKT         &kp RBKT     &mo 3
            >;
        };
    };
};
